// Evidence-led discovery. Composite foreign keys prevent cross-tenant links.
enum OpportunityType {
  INTERNAL_HIRING
  EXTERNAL_VENDOR
  IMPLEMENTATION
  INTEGRATION
  CONSULTING
  OUTSOURCING
  STAFF_AUGMENTATION
  PROJECT
  RFP
  MIGRATION
  DIGITAL_TRANSFORMATION
  UNKNOWN
}

enum OpportunityStatus {
  NEW
  ACTIVE
  AGING
  CLOSED
  EXPIRED
  PAUSED
  OPEN
  AWARDED
  CANCELLED
  UNKNOWN
}

enum DiscoveryState {
  QUEUED
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
  CANCELLED
}

model Opportunity {
  id               String                    @id @default(uuid()) @db.Uuid
  workspaceId      String                    @db.Uuid
  companyId        String                    @db.Uuid
  title            String
  service          String
  types            OpportunityType[]
  status           OpportunityStatus         @default(UNKNOWN)
  technologies     String[]
  requirements     String[]
  location         String?
  postedAt         DateTime?
  closingAt        DateTime?
  discoveredAt     DateTime                  @default(now())
  lastSeenAt       DateTime                  @default(now())
  lastCheckedAt    DateTime                  @default(now())
  lastChangedAt    DateTime?
  updatedAt        DateTime                  @updatedAt
  activeRank       Int                       @default(0)
  intentScore      Int                       @default(0)
  fitScore         Int                       @default(0)
  opportunityScore Int                       @default(0)
  scores           Json                      @default("{}")
  summary          String?
  dedupeKey        String
  deletedAt        DateTime?
  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company          Company                   @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)
  sources          OpportunitySource[]
  evidence         OpportunityEvidence[]
  versions         OpportunityVersion[]
  results          OpportunitySearchResult[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status, intentScore])
  @@index([workspaceId, companyId])
  @@index([workspaceId, postedAt])
  @@index([workspaceId, discoveredAt])
}

model OpportunitySource {
  id              String      @id @default(uuid()) @db.Uuid
  workspaceId     String      @db.Uuid
  opportunityId   String      @db.Uuid
  provider        String
  kind            String
  externalId      String
  sourceUrl       String
  title           String
  description     String
  postedAt        DateTime?
  sourceUpdatedAt DateTime?
  discoveredAt    DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())
  contentHash     String
  rawReference    Json
  allowedExport   Boolean     @default(false)
  expiresAt       DateTime
  opportunity     Opportunity @relation(fields: [workspaceId, opportunityId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, opportunityId])
  @@index([workspaceId, expiresAt])
}

model OpportunityEvidence {
  id                String      @id @default(uuid()) @db.Uuid
  workspaceId       String      @db.Uuid
  opportunityId     String      @db.Uuid
  type              String
  description       String
  source            String
  sourceUrl         String
  occurredAt        DateTime?
  discoveredAt      DateTime    @default(now())
  confidence        Int
  scoreContribution Int
  rawReference      Json
  opportunity       Opportunity @relation(fields: [workspaceId, opportunityId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, opportunityId])
}

model OpportunityVersion {
  id            String      @id @default(uuid()) @db.Uuid
  workspaceId   String      @db.Uuid
  opportunityId String      @db.Uuid
  sourceId      String
  previousHash  String
  currentHash   String
  changedAt     DateTime    @default(now())
  changedFields Json
  opportunity   Opportunity @relation(fields: [workspaceId, opportunityId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, opportunityId, changedAt])
}

model OpportunitySearch {
  id              String                    @id @default(uuid()) @db.Uuid
  workspaceId     String                    @db.Uuid
  createdById     String                    @db.Uuid
  query           String
  criteria        Json
  providers       String[]
  state           DiscoveryState            @default(QUEUED)
  progress        Int                       @default(0)
  steps           Json                      @default("{}")
  providerResults Json                      @default("{}")
  error           String?
  found           Int                       @default(0)
  qualified       Int                       @default(0)
  savedSearchId   String?                   @db.Uuid
  /// Set when a watched search phrase ran this search, so its matches are attributed to the phrase.
  searchPhraseId  String?                   @db.Uuid
  idempotencyKey  String
  /// Depth, target, budget and edited queries chosen for this run (lib/opportunities/linkedin-plan.ts).
  options         Json                      @default("{}")
  /// Pages already fetched and processed, so a redelivered job resumes instead of paying twice.
  checkpoint      Json                      @default("{}")
  cancelRequestedAt DateTime?
  createdAt       DateTime                  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  workspace       Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  results         OpportunitySearchResult[]
  candidates      DiscoveryCandidate[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
}

model OpportunitySearchResult {
  workspaceId   String            @db.Uuid
  searchId      String            @db.Uuid
  opportunityId String            @db.Uuid
  search        OpportunitySearch @relation(fields: [workspaceId, searchId], references: [workspaceId, id], onDelete: Cascade)
  opportunity   Opportunity       @relation(fields: [workspaceId, opportunityId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, searchId, opportunityId])
}

model ProviderConnection {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @db.Uuid
  provider             String
  encryptedCredentials String?
  config               Json      @default("{}")
  enabled              Boolean   @default(true)
  allowedSearch        Boolean   @default(false)
  allowedStorage       Boolean   @default(false)
  allowedEnrichment    Boolean   @default(false)
  allowedExport        Boolean   @default(false)
  allowedOutreach      Boolean   @default(false)
  retentionDays        Int       @default(30)
  status               String    @default("UNTESTED")
  lastTestedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model ProviderSync {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @db.Uuid
  provider       String
  operation      String
  jobId          String?
  state          String
  recordsFound   Int       @default(0)
  recordsCreated Int       @default(0)
  recordsUpdated Int       @default(0)
  duplicates     Int       @default(0)
  requests       Int       @default(0)
  credits        Float?
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, provider, startedAt])
}

// Search evidence whose buyer has not yet been resolved. Never masquerades as a CRM lead.
model DiscoveryCandidate {
  id            String @id @default(uuid()) @db.Uuid
  workspaceId   String @db.Uuid
  searchId      String @db.Uuid
  provider      String
  sourceUrl     String
  title         String
  description   String
  kind          String
  postedAt      DateTime?
  document      Json
  /// REVIEW, REJECTED, QUALIFIED or DISMISSED.
  status        String @default("REVIEW")
  /// The primary reason it is in review or was rejected (DISCOVERY_REASON in lib/vocab.ts).
  reason        String?
  /// buying, seller_promotion, job_seeker, internal_hiring, informational or unclear.
  classification String?
  /// Matched phrases, filter checks (known vs unknown) and the query that found it.
  evidence      Json @default("{}")
  /// DONE, or RETRY_PENDING when attribution could not run and can be retried.
  processing    String @default("DONE")
  /// A buyer the rules could read from the author's headline. Never qualifies on its own.
  suggestedBuyer String?
  opportunityId String? @db.Uuid
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  search        OpportunitySearch @relation(fields: [workspaceId, searchId], references: [workspaceId, id], onDelete: Cascade)
  @@unique([workspaceId, searchId, sourceUrl])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, searchId, status])
}

/// A pending invitation to join a workspace. Only the token's hash is stored;
/// the link is shown once to the person who created or resent it.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  email       String
  roleId      String    @db.Uuid
  tokenHash   String    @unique
  invitedById String?   @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedBy  String?   @db.Uuid
  revokedAt   DateTime?
  /// When the invitation link was emailed, and why it was not when that failed.
  emailedAt   DateTime?
  emailError  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

/// Workspace-wide starting values for new proposals. A proposal copies these
/// when it is created, so changing them never alters one already issued.
model ProposalDefaults {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @unique @db.Uuid
  taxRate      Decimal  @default(18) @db.Decimal(5, 2)
  validityDays Int      @default(30)
  terms        String?
  pricingNote  String?
  description  String?
  contactEmail String?
  contactPhone String?
  website      String?
  address      String?
  /// PNG/JPEG/WebP as a data URL, at most 256 KB. No SVG: it can carry script.
  logoDataUrl  String?
  /// [{ name, unit, priceInr, inclusions[] }] — priceInr is the authoritative amount.
  packages     Json     @default("[]")
  /// [{ title, summary }]
  caseStudies  Json     @default("[]")
  updatedById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// A request for help, routed to the workspace's administrators. `reference`
/// is the short case id people quote; `history` is the status trail.
model SupportRequest {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  reference   String   @unique
  createdById String   @db.Uuid
  subject     String
  message     String
  status      String   @default("open")
  /// [{ at, by, status, note }]
  history     Json     @default("[]")
  /// What the diagnostics page showed when the request was made.
  diagnostics Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// A person's choice to mute one kind of in-app notification in one workspace.
/// Absence means on. Email and push are not built, so there is no column for them.
model NotificationPreference {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String           @db.Uuid
  kind        NotificationKind
  inApp       Boolean          @default(true)
  /// Also email this kind to the person. Off unless they turn it on.
  email       Boolean          @default(false)
  /// Also push this kind to the person's subscribed browsers. Off unless they turn it on.
  push        Boolean          @default(false)
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, kind])
}

/// A deal's working plan across sales, delivery and cash. One per deal,
/// created from a versioned template; the steps are then the deal's own.
model DealPlan {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  dealId          String   @unique @db.Uuid
  templateKey     String
  templateVersion Int
  createdById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal      Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  steps     DealPlanStep[]

  @@index([workspaceId])
}

/// One step. `dependsOn` holds the `key`s of steps that must be done first.
/// A gate step needs a recorded client approval before it can be completed;
/// the approver's name is as the team recorded it, not verified.
model DealPlanStep {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @db.Uuid
  planId              String    @db.Uuid
  key                 String
  order               Int
  phase               String
  title               String
  completionCriteria  String?
  dependsOn           String[]
  isClientGate        Boolean   @default(false)
  status              String    @default("todo")
  /// The skill a person needs to own this step; routing only offers people who have it.
  requiredSkill       String?
  ownerId             String?   @db.Uuid
  artifact            String?
  note                String?
  clientApprovedBy    String?
  clientApprovedAt    DateTime?
  completedAt         DateTime?
  completedById       String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  plan DealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([workspaceId, ownerId, status])
}

/// A workspace's own plan template, saved from a plan. Saving under an existing
/// name adds a version; plans already started keep the steps they were given.
model PlanTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  version     Int
  /// [{ key, phase, title, completionCriteria, dependsOn, isClientGate }]
  steps       Json
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name, version])
  @@index([workspaceId, deletedAt])
}

/// A company-level address or number (info@, sales@, a switchboard). Never assigned to a person.
model CompanyContactPoint {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  companyId          String    @db.Uuid
  kind               String
  value              String
  /// A role address (info@, sales@) rather than one that names a person.
  isGeneric          Boolean   @default(true)
  /// matched (website domain) · alias (corroborated email domain) · review (unresolved) · rejected (a person said not the company's) · free (free mailbox).
  domainStatus       String    @default("matched")
  /// A saved person this address may belong to, inferred from their name but not strong enough to attach.
  possiblePersonId   String?   @db.Uuid
  source             String
  evidence           Json      @default("{}")
  verificationResult String    @default("UNCHECKED")
  verification       Json      @default("{}")
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, companyId, value])
  @@index([workspaceId, companyId])
}

/// One press of Research / Find people / Find emails / Check emails / Enrich, with each stage's outcome.
model EnrichmentRun {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  opportunityId     String    @db.Uuid
  companyId         String    @db.Uuid
  requestedById     String?   @db.Uuid
  /// research, people, emails, verify or enrich
  kind              String
  trigger           String    @default("manual")
  /// QUEUED, RUNNING, COMPLETED, NO_MATCHES, PARTIAL, NEEDS_SELECTION, FAILED, CANCELLED
  state             String    @default("QUEUED")
  refresh           Boolean   @default(false)
  stages            Json      @default("[]")
  result            Json      @default("{}")
  budgetUsd         Float
  spentUsd          Float     @default(0)
  estimatedUsd      Float     @default(0)
  error             String?
  jobKey            String?
  cancelRequestedAt DateTime?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  apifyRuns         ApifyRun[]

  @@unique([workspaceId, id])
  @@index([workspaceId, opportunityId, createdAt])
  @@index([workspaceId, state])
}

/// Every chargeable Apify run, recorded before waiting on it, so a retry reads the same run instead of paying again.
model ApifyRun {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  enrichmentRunId String?        @db.Uuid
  stageKey        String
  actorId         String
  inputHash       String
  input           Json
  runId           String?
  datasetId       String?
  status          String         @default("STARTING")
  itemCount       Int            @default(0)
  usageUsd        Float?
  estimatedUsd    Float          @default(0)
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  enrichmentRun   EnrichmentRun? @relation(fields: [workspaceId, enrichmentRunId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, enrichmentRunId, stageKey])
  @@index([workspaceId, actorId, inputHash])
}

/// What the workspace sells, described so discovery can ask each platform the right way: buyer
/// phrases for request platforms, the job titles a company posts when it needs this for job boards,
/// and business categories for Maps. Fit criteria (industries, size, locations) stay separate from
/// the intent phrases, because they answer different questions.
model OfferingProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  name               String
  description        String    @default("")
  services           String[]
  technologies       String[]
  buyerPhrases       String[]
  jobTitles          String[]
  prospectCategories String[]
  industries         String[]
  locations          String[]
  employeeMin        Int?
  employeeMax        Int?
  negativeKeywords   String[]
  platforms          String[]
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, deletedAt])
}

/// One external lookup from Lead Lens: what was asked, which provider answered, and what was saved.
/// Doubles as the cache — a found result inside the freshness window is shown again, not bought again.
model ExternalLookup {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  requestedById String?   @db.Uuid
  kind          String
  target        String
  targetKey     String
  provider      String?
  status        String    @default("RUNNING")
  personId      String?   @db.Uuid
  companyId     String?   @db.Uuid
  candidates    Json      @default("[]")
  note          String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetKey, createdAt])
  @@index([workspaceId, createdAt])
}

/// A workspace mailbox whose replies are read over IMAP, so stop-on-reply is automatic. The password
/// is encrypted with the provider key and never returned. Revoking erases it and stops reading.
model Mailbox {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  label             String
  address           String
  /// "imap" (IMAP reading, optional SMTP sending), "gmail" or "microsoft" (OAuth, both directions).
  provider          String    @default("imap")
  imapHost          String?
  imapPort          Int       @default(993)
  imapSecure        Boolean   @default(true)
  imapUser          String?
  encryptedPassword String?
  /// Receiving is on unless someone turns it off; a send-only mailbox reads nothing.
  receiveEnabled    Boolean   @default(true)
  smtpHost          String?
  smtpPort          Int?
  /// "tls" (implicit, usually 465) or "starttls" (usually 587). Never plain text.
  smtpSecurity      String?
  smtpUser          String?
  encryptedSmtpPassword String?
  /// NONE (cannot send), CONNECTED, ERROR, REVOKED.
  sendStatus        String    @default("NONE")
  sendLastError     String?
  sendTestedAt      DateTime?
  fromName          String?
  isDefaultSender   Boolean   @default(false)
  /// OAuth tokens (gmail / microsoft), encrypted; never returned.
  encryptedTokens   String?
  scopes            String[]  @default([])
  /// Provider read cursor for OAuth mailboxes (Gmail historyId, Graph receivedDateTime).
  readCursor        String?
  folder            String    @default("INBOX")
  status            String    @default("UNTESTED")
  lastError         String?
  lastTestedAt      DateTime?
  uidValidity       String?
  lastUid           Int       @default(0)
  lastSyncedAt      DateTime?
  repliesMatched    Int       @default(0)
  createdById       String?   @db.Uuid
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, address])
  @@index([workspaceId, status])
}

/// One person's calendar, connected over OAuth so bookings create, move and cancel real events.
/// Tokens are encrypted and never returned; revoking tells the provider and erases them.
model CalendarConnection {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  userId          String    @db.Uuid
  provider        String
  email           String?
  calendarId      String    @default("primary")
  encryptedTokens String?
  scopes          String[]
  status          String    @default("CONNECTED")
  lastError       String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, provider])
}

/// One call to a fallback provider (SignalHire, Hunter, Apollo) for one operation and target. The
/// row is written before the call, so a redelivered job or a second press does not pay again; its
/// outcome keeps invalid credentials, missing entitlement, quota, rate limits, transient failures,
/// unsupported operations and genuine no-matches apart. Counting today's rows enforces the daily
/// cap across runs that happen at the same time.
model ProviderCall {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  enrichmentRunId String?   @db.Uuid
  provider        String
  operation       String
  targetKey       String
  status          String    @default("STARTED")
  detail          String?
  units           Float     @default(0)
  attempt         Int       @default(1)
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, enrichmentRunId, provider, operation, targetKey])
  @@index([workspaceId, provider, operation, targetKey, createdAt])
  @@index([workspaceId, createdAt])
}

/// One browser's Web Push subscription for one person. Pushes carry no content: the service worker
/// fetches the notification over the person's own session, so nothing readable passes through the
/// push service. Removed when the push service says it is gone (404/410).
model PushSubscription {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  endpoint    String
  p256dh      String
  auth        String
  userAgent   String?
  failures    Int       @default(0)
  lastError   String?
  lastPushedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, endpoint])
  @@index([workspaceId, userId])
}

/// A request to pay for a plan through a payment provider (a Razorpay Payment Link). The amount
/// is the plan's listed price at the time, in integer paise; the subscription changes only when
/// the provider reports that exact amount paid.
model BillingCheckout {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  provider    String
  /// The provider's id for the link or order.
  providerRef String
  planId      String    @db.Uuid
  period      String
  amountPaise Int
  currency    String
  /// CREATED, PAID, MISMATCH (paid a different amount — not activated), EXPIRED, CANCELLED.
  status      String    @default("CREATED")
  testMode    Boolean
  url         String?
  paymentRef  String?
  note        String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([workspaceId, createdAt])
}

/// Every webhook a payment provider sent, keyed by its own event id, so a redelivered event is
/// recognised and changes nothing. Payloads are kept only as the fields this app acted on.
model BillingEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  type        String
  workspaceId String?   @db.Uuid
  checkoutId  String?   @db.Uuid
  outcome     String
  detail      Json      @default("{}")
  receivedAt  DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([workspaceId, receivedAt])
}
