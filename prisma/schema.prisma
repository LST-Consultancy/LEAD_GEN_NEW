  pushClaimedAt  DateTime?
  pushedAt       DateTime?
  emailedAt   DateTime?
  emailError  String?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
